# Cloudflare Pages: always revalidate pages, styles and scripts so updates show immediately.
/*
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400

/icon-*.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400
